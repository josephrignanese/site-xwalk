{
  "definitions": [
    {
      "title": "External Image",
      "id": "external-image",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "External Image",
              "model": "external-image",
              "imageMimeType": "image/webp"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "external-image",
      "fields": [
        {
          "component": "text",
          "name": "image",
          "value": "",
          "label": "Image URL",
          "valueType": "string",
          "validation": {
            "regExp": "^https://.*",
            "customErrorMsg": "Image URL needs to start with https"
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt Text",
          "value": ""
        },
        {
          "component": "select",
          "name": "imageMimeType",
          "label": "Image Type",
          "valueType": "string",
          "options": [
            { "name": "WEBP", "value": "image/webp" },
            { "name": "JPEG", "value": "image/jpeg" }
          ]
        }
      ]
    }
  ],
  "filters": []
}